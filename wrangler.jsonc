{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imperyamediasolutions",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "IMPERYA_STORAGE",
      "id": "imperya_storage"
    }
  ]
}
