{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imperyareact",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "IMPERYA_STORAGE",
      "id": "433cae16ac5b4e78bdac93d2d45b2d0c"
    }
  ],
  "vars": {
    "PAYTR_MERCHANT_ID": "756001",
    "PAYTR_MERCHANT_KEY": "m6e8n9KybSHn4pif",
    "PAYTR_MERCHANT_SALT": "tx3Z4RbskLYeSHQi"
  }
}
